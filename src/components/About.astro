---
import { site } from '../data/site';
---
<section id="about" class="frame about section-screen" aria-labelledby="about-title">
  <div class="grid">
    <div class="text">
      <h2 id="about-title" class="wipe" data-split>About</h2>
      <div data-reveal>
        <p class="bio">
          <strong>{site.name}</strong> is a student who builds for the web. I care about pages that load fast,
          read clearly and hold up on a phone. My first client site is live on its own domain.
        </p>
        <p class="bio soft">
          Next I'm going deeper into security: how sites get attacked, and how to build them so they don't.
        </p>
        <dl class="facts">
          <div><dt>Based in</dt><dd>{site.location}</dd></div>
          <div><dt>Studying</dt><dd>{site.study}<span class="sub">{site.studyAt}</span></dd></div>
          <div><dt>Open to</dt><dd>{site.openTo}</dd></div>
        </dl>
        <p><a class="link" href="/about">Experience and education</a></p>
      </div>
    </div>
    <div class="visual" data-reveal>
      {/* TODO(musa): a portrait photo could sit here instead of the orb */}
      <canvas class="orb" data-orb aria-hidden="true"></canvas>
    </div>
  </div>
</section>

<script>
  import { whenQuiet } from '../scripts/quiet';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-orb]');
  if (canvas) {
    // Building the orb (WebGL context, environment map) blocks the page for a few hundred ms.
    // Do it a few seconds after load, after the hero globe, once the page isn't being scrolled.
    // Scrolling near it first still mounts it straight away.
    let mounted = false;
    const mount = () => {
      if (mounted) return;
      mounted = true;
      io.disconnect();
      import('../scripts/three/orb').then((m) => m.mountOrb(canvas));
    };
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) mount(); }, { rootMargin: '300px' });
    io.observe(canvas);
    const later = () => setTimeout(() => whenQuiet(mount), 3500);
    const start = () => {
      if (document.readyState === 'complete') later();
      else window.addEventListener('load', later, { once: true });
    };
    // Same gate as the globe: wait for the preloader to finish.
    if (document.documentElement.classList.contains('ready')) start();
    else window.addEventListener('intro:done', start, { once: true });
  }
</script>

<style>
  .grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2vw, 2rem); align-items: center; }
  .text { grid-column: 1 / 7; }
  .visual { grid-column: 7 / 13; }
  h2 { font-size: var(--step-head); margin-bottom: 2.5rem; }
  .bio { font-size: clamp(1.375rem, 1rem + 1.1vw, 1.875rem); line-height: 1.3; letter-spacing: -0.01em; }
  .bio + .bio { margin-top: 1.25rem; }
  strong { font-weight: 400; color: var(--accent); }
  .soft { color: var(--muted); }
  .facts { display: grid; gap: 1.1rem; margin: 2.75rem 0 2rem; font-size: 1rem; }
  .facts div { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 1rem; align-items: baseline; }
  dt { color: var(--muted); font-size: var(--step-small); }
  .sub { display: block; margin-top: 0.15rem; color: var(--muted); font-size: var(--step-small); }
  .orb { display: block; width: 100%; aspect-ratio: 1; max-width: 560px; margin-inline: auto; cursor: crosshair; }

  @media (max-width: 900px) {
    .grid { display: flex; flex-direction: column; gap: 2rem; }
    .visual { order: -1; }
    .orb { max-width: 240px; }
  }
</style>
