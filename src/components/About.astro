---
import { site } from '../data/site';
---
<section id="about" class="frame about section-screen" aria-labelledby="about-title">
  <div class="grid">
    <div class="text">
      <h2 id="about-title" class="wipe" data-split>About</h2>
      <div data-reveal>
        <p class="bio">
          <strong>{site.name}</strong> is a student who builds for the web. I care about pages that load fast,
          read clearly and hold up on a phone. My first client site is live on its own domain.
        </p>
        <p class="bio soft">
          Next I'm going deeper into security: how sites get attacked, and how to build them so they don't.
        </p>
        <dl class="facts">
          <div><dt>Based in</dt><dd>{site.location}</dd></div>
          <div><dt>Studying</dt><dd>{site.study}</dd></div>
          <div><dt>Open to</dt><dd>{site.openTo}</dd></div>
        </dl>
        <p><a class="link" href="/about">Experience and education</a></p>
      </div>
    </div>
    <div class="visual" data-reveal>
      {/* TODO(musa): a portrait photo could sit here instead of the orb */}
      <canvas class="orb" data-orb aria-hidden="true"></canvas>
    </div>
  </div>
</section>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-orb]');
  if (canvas) {
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      import('../scripts/three/orb').then((m) => m.mountOrb(canvas));
    }, { rootMargin: '300px' });
    io.observe(canvas);
  }
</script>

<style>
  .grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2vw, 2rem); align-items: center; }
  .text { grid-column: 1 / 7; }
  .visual { grid-column: 7 / 13; }
  h2 { font-size: var(--step-head); margin-bottom: 2.5rem; }
  .bio { font-size: clamp(1.375rem, 1rem + 1.1vw, 1.875rem); line-height: 1.3; letter-spacing: -0.01em; }
  .bio + .bio { margin-top: 1.25rem; }
  strong { font-weight: 400; color: var(--accent); }
  .soft { color: var(--muted); }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin: 2.75rem 0 2rem; font-size: 1rem; }
  dt { color: var(--muted); font-size: var(--step-small); margin-bottom: 0.25rem; }
  .orb { display: block; width: 100%; aspect-ratio: 1; max-width: 560px; margin-inline: auto; cursor: crosshair; }

  @media (max-width: 900px) {
    .grid { display: flex; flex-direction: column; gap: 2rem; }
    .orb { max-width: 340px; }
    .facts { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
