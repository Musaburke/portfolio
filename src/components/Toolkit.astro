---
import Shot from './Shot.astro';
import afgHome from '../assets/projects/afg-home.jpg';
import btaInbox from '../assets/projects/bta-inbox.jpg';
import renewlyDashboard from '../assets/projects/renewly-dashboard.jpg';
import dsbContact from '../assets/projects/dsb-contact.jpg';
import security from '../assets/projects/portfolio-security-headers.jpg';
import btaDebrief from '../assets/projects/bta-debrief.jpg';
import { toolkit, type Shot as ShotKey } from '../data/toolkit';

const shots: Record<ShotKey, { src: ImageMetadata; host: string }> = {
  afgHome: { src: afgHome, host: 'musa-ai-field-guide.pages.dev' },
  btaInbox: { src: btaInbox, host: 'break-the-ai.muburke07.workers.dev' },
  renewlyDashboard: { src: renewlyDashboard, host: 'Renewly · sample data' },
  dsbContact: { src: dsbContact, host: 'dsbcommercialcleaning.co.uk/contact' },
  security: { src: security, host: 'public/_headers · this site' },
  btaDebrief: { src: btaDebrief, host: 'break-the-ai.muburke07.workers.dev' },
};
const used = [...new Set(toolkit.map((t) => t.shot))];
const first = toolkit[0].shot;
---
<section id="toolkit" class="frame kit section-screen" aria-labelledby="kit-title">
  <h2 id="kit-title" class="wipe" data-split>What I work with</h2>
  <div class="stage" aria-hidden="true">
    {used.map((key) => (
      <div class:list={['slot', { on: key === first }]} data-shot={key}>
        <Shot src={shots[key].src} alt="" host={shots[key].host} sizes="(max-width: 900px) 100vw, 55vw" />
      </div>
    ))}
  </div>

  <div class="list">
    <ul>
      {toolkit.map((t, i) => (
        <li class:list={['row', { active: i === 0 }]} data-shot={t.shot}>
          <button type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`kit-${i}`}>
            <span class="tool">{t.name}</span>
          </button>
          <p id={`kit-${i}`} class="detail">{t.detail}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const kit = document.getElementById('toolkit');
  if (kit) {
    const rows = [...kit.querySelectorAll<HTMLLIElement>('.row')];
    const slots = [...kit.querySelectorAll<HTMLElement>('.slot')];
    const activate = (row: HTMLLIElement) => {
      for (const r of rows) {
        const on = r === row;
        r.classList.toggle('active', on);
        r.querySelector('button')?.setAttribute('aria-expanded', String(on));
      }
      for (const s of slots) s.classList.toggle('on', s.dataset.shot === row.dataset.shot);
    };
    for (const row of rows) {
      row.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') activate(row); });
      row.querySelector('button')?.addEventListener('click', () => activate(row));
      row.querySelector('button')?.addEventListener('focus', () => activate(row));
    }
  }
</script>

<style>
  .kit {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    align-items: center;
  }
  h2 { grid-column: 9 / 13; grid-row: 1; align-self: end; }
  .stage { grid-column: 1 / 8; grid-row: 1 / span 2; position: sticky; top: 16vh; display: grid; }
  .slot { grid-area: 1 / 1; opacity: 0; transform: scale(0.985); transition: opacity 360ms ease, transform 500ms var(--ease-out); }
  .slot.on { opacity: 1; transform: none; }
  .list { grid-column: 9 / 13; grid-row: 2; align-self: start; }
  h2 { font-size: var(--step-head); margin-bottom: 2.5rem; }
  .row { display: block; }
  button {
    all: unset; box-sizing: border-box; cursor: pointer;
    width: 100%; min-height: 58px;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .tool { font-size: clamp(1.25rem, 1rem + 0.8vw, 1.5rem); color: var(--muted); transition: color 180ms ease; letter-spacing: -0.01em; }
  .row.active .tool { color: var(--ink); }
  .detail { max-width: 38ch; font-size: 1rem; display: none; padding-bottom: 1.25rem; }
  .row.active .detail { display: block; }

  @media (max-width: 900px) {
    .kit { display: block; }
    .stage { position: relative; top: auto; }
    h2 { margin-bottom: 1.75rem; }
    .list { margin-top: 2rem; }
    button { min-height: 56px; }
  }
  @media (prefers-reduced-motion: reduce) { .slot { transition: none; transform: none; } }
</style>
