---
// Starlight background: a fixed canvas of twinkling stars behind every page.
// Heartbeat pulse (lub-dub) ripples out from the top centre; the cursor brightens
// and parts the stars and links the nearest into faint constellations; rare shooting
// stars; layered parallax on scroll and pointer. Publishes the beat on window.__beat
// so the hero globe pulses in time.
// Reduced motion: one still frame, redrawn on resize only.
---
<canvas id="starfield" aria-hidden="true"></canvas>

<style>
  #starfield {
    position: fixed; inset: 0; width: 100%; height: 100%;
    z-index: -1; pointer-events: none; display: block;
  }
</style>

<script>
  import { isStill } from '../scripts/still';

  type Star = {
    x: number; y: number; r: number; base: number;
    phase: number; speed: number; layer: 0 | 1 | 2; tint: 0 | 1;
    ox: number; oy: number; // current displacement from the cursor push
  };

  const canvas = document.getElementById('starfield') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const finePointer = matchMedia('(pointer: fine)');

    const PERIOD = 4800;          // ms between heartbeats
    const BEAT_SPEED = 0.9;       // px per ms the pulse travels outward
    const PUSH_RADIUS = 190;      // px around the cursor that react
    const LAYER_PARALLAX = [4, 9, 16];      // px of pointer parallax per layer
    const LAYER_SCROLL = [0.015, 0.04, 0.08]; // scroll drift per layer
    const LINK_DIST = 110;        // px: max length of a constellation line
    const linked: number[] = [];  // x, y, strength of stars near the cursor this frame
    const WARP_LAYER = [0.5, 1, 1.8]; // how fast each depth layer streams past in warp
    const STREAK = [14, 36, 80];      // streak length per layer at full warp
    let warpS = 0, warpPos = 0;       // smoothed warp level and accumulated travel

    let w = 0, h = 0, dpr = 1;
    let stars: Star[] = [];
    let raf = 0;
    let mouseX = -9999, mouseY = -9999;      // raw pointer
    let sx = 0, sy = 0;                      // smoothed pointer for parallax
    let pointerIn = false;
    let boost = 0, boostTarget = 0;          // stronger pulse while contact is on screen
    let shooting: { x: number; y: number; vx: number; vy: number; life: number } | null = null;
    let nextShot = performance.now() + 6000 + Math.random() * 10000;

    // Pre-rendered glow sprites: warm white and sage.
    const sprite = (rgb: string) => {
      const s = document.createElement('canvas');
      s.width = s.height = 64;
      const g = s.getContext('2d')!;
      const grad = g.createRadialGradient(32, 32, 0, 32, 32, 32);
      grad.addColorStop(0, `rgba(${rgb},1)`);
      grad.addColorStop(0.12, `rgba(${rgb},0.9)`);
      grad.addColorStop(0.3, `rgba(${rgb},0.25)`);
      grad.addColorStop(1, `rgba(${rgb},0)`);
      g.fillStyle = grad;
      g.fillRect(0, 0, 64, 64);
      return s;
    };
    const sprites = [sprite('244,239,228'), sprite('168,196,166')];
    const cursorGlow = sprite('159,208,156');

    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    function build() {
      dpr = Math.min(window.devicePixelRatio || 1, 1.5); // a full-screen canvas: 1.5 looks the same as 2 for soft dots, at half the pixels
      w = window.innerWidth;
      h = window.innerHeight;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.min(900, Math.round((w * h) / 2600));
      stars = Array.from({ length: count }, () => {
        const roll = Math.random();
        const layer: 0 | 1 | 2 = roll < 0.7 ? 0 : roll < 0.95 ? 1 : 2;
        return {
          x: Math.random() * w,
          y: Math.random() * h,
          r: layer === 0 ? rand(0.5, 0.95) : layer === 1 ? rand(0.95, 1.5) : rand(1.6, 2.4),
          base: layer === 0 ? rand(0.25, 0.55) : layer === 1 ? rand(0.45, 0.75) : rand(0.7, 0.9),
          phase: Math.random() * Math.PI * 2,
          speed: rand(0.0006, 0.0022),
          layer,
          tint: Math.random() < 0.08 ? 1 : 0,
          ox: 0, oy: 0,
        };
      });
    }

    // Lub-dub: two gaussian swells, the second softer.
    const gauss = (t: number, mu: number, sig: number) => Math.exp(-((t - mu) ** 2) / (2 * sig * sig));
    const beat = (t: number) => gauss(t, 0, 90) + 0.6 * gauss(t, 290, 120);
    // The swell is over within ~800 ms, so look it up from a 1 ms table instead of calling exp() per star per frame.
    const BEAT_FROM = -600, BEAT_TO = 800;
    const beatTable = Float32Array.from({ length: BEAT_TO - BEAT_FROM + 1 }, (_, i) => beat(i + BEAT_FROM));
    const beatAt = (local: number) => {
      const t = local > PERIOD / 2 ? local - PERIOD : local;
      if (t < BEAT_FROM || t >= BEAT_TO) return 0;
      const f = t - BEAT_FROM, i = f | 0;
      return beatTable[i] + (beatTable[i + 1] - beatTable[i]) * (f - i);
    };

    function frame(now: number, still = false) {
      ctx!.clearRect(0, 0, w, h);
      const scrollY = window.scrollY;
      sx += ((pointerIn ? mouseX : w / 2) - sx) * 0.06;
      sy += ((pointerIn ? mouseY : h / 2) - sy) * 0.06;
      boost += (boostTarget - boost) * 0.04;
      const px = (sx - w / 2) / w, py = (sy - h / 2) / h;
      const originX = w / 2, originY = h * 0.3 - scrollY * 0.2;
      const amp = 0.35 + boost * 0.4;
      const beatNow = beatAt(((now % PERIOD) + PERIOD) % PERIOD);
      (window as unknown as { __beat: number }).__beat = still ? 0 : beatNow;
      linked.length = 0;
      const wTarget = still ? 0 : (window as unknown as { __warp?: number }).__warp ?? 0;
      warpS += (wTarget - warpS) * 0.08;
      warpPos += warpS * 9;
      const kick = (window as unknown as { __kick?: number }).__kick ?? -1e9;
      const kickExtra = !still && now >= kick ? Math.exp(-(now - kick) / 500) * 2 : 0;
      const streaks = warpS > 0.04;
      if (streaks) ctx!.beginPath();

      for (const s of stars) {
        // Base position with scroll drift (wrapped) and pointer parallax.
        let x = s.x - px * LAYER_PARALLAX[s.layer];
        let y = s.y - scrollY * LAYER_SCROLL[s.layer] - py * LAYER_PARALLAX[s.layer] - warpPos * WARP_LAYER[s.layer];
        y = ((y % h) + h) % h;

        let near = 0;
        if (!still && pointerIn) {
          const dx = x - mouseX, dy = y - mouseY;
          const d2 = dx * dx + dy * dy;
          const d = d2 < PUSH_RADIUS * PUSH_RADIUS ? Math.sqrt(d2) : PUSH_RADIUS;
          if (d < PUSH_RADIUS && d > 0.01) {
            near = 1 - d / PUSH_RADIUS;
            const push = near * near * 22;
            s.ox += ((dx / d) * push - s.ox) * 0.12;
            s.oy += ((dy / d) * push - s.oy) * 0.12;
          } else {
            s.ox *= 0.92; s.oy *= 0.92;
          }
        } else {
          s.ox *= 0.92; s.oy *= 0.92;
        }
        x += s.ox; y += s.oy;

        let a = s.base;
        let r = s.r;
        if (!still) {
          a *= 0.62 + 0.38 * Math.sin(now * s.speed + s.phase);
          const bx = x - originX, by = y - originY;
          const delay = Math.sqrt(bx * bx + by * by) / BEAT_SPEED;
          const pulse = beatAt((((now - delay) % PERIOD) + PERIOD) % PERIOD);
          a *= 1 + (pulse + kickExtra) * amp * (s.layer === 0 ? 1 : 1.4);
          r *= 1 + pulse * 0.25;
          a += near * 0.8;
          r *= 1 + near * 0.6;
        }
        a = Math.min(0.95, Math.max(0.12, a));
        if (near > 0.15 && s.layer > 0 && linked.length < 40) linked.push(x, y, near);

        const size = r * (s.layer === 2 ? 9 : 6);
        ctx!.globalAlpha = a;
        ctx!.drawImage(sprites[s.tint], x - size / 2, y - size / 2, size, size);
        if (streaks) { ctx!.moveTo(x, y); ctx!.lineTo(x, y + STREAK[s.layer] * warpS); }
      }
      if (streaks) {
        ctx!.globalAlpha = 0.3 * warpS;
        ctx!.strokeStyle = '#f4efe4';
        ctx!.lineWidth = 1;
        ctx!.stroke();
      }

      // Constellation lines between the brighter stars near the cursor.
      if (linked.length > 3) {
        ctx!.strokeStyle = '#d9e4d8';
        ctx!.lineWidth = 0.6;
        for (let i = 0; i < linked.length; i += 3) {
          for (let k = i + 3; k < linked.length; k += 3) {
            const d = Math.hypot(linked[i] - linked[k], linked[i + 1] - linked[k + 1]);
            if (d > LINK_DIST) continue;
            ctx!.globalAlpha = (1 - d / LINK_DIST) * Math.min(linked[i + 2], linked[k + 2]) * 0.55;
            ctx!.beginPath();
            ctx!.moveTo(linked[i], linked[i + 1]);
            ctx!.lineTo(linked[k], linked[k + 1]);
            ctx!.stroke();
          }
        }
      }

      if (!still && pointerIn && finePointer.matches) {
        ctx!.globalAlpha = 0.07;
        ctx!.drawImage(cursorGlow, mouseX - 220, mouseY - 220, 440, 440);
      }

      if (!still) drawShootingStar(now);
      ctx!.globalAlpha = 1;
    }

    function drawShootingStar(now: number) {
      if (!shooting && now > nextShot) {
        const fromLeft = Math.random() < 0.5;
        const speed = rand(1.1, 1.6);
        const angle = rand(0.25, 0.5);
        shooting = {
          x: fromLeft ? rand(0, w * 0.5) : rand(w * 0.5, w),
          y: rand(0, h * 0.4),
          vx: (fromLeft ? 1 : -1) * Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          life: 0,
        };
      }
      if (!shooting) return;
      const s = shooting;
      s.life += 16;
      s.x += s.vx * 16; s.y += s.vy * 16;
      const fade = Math.sin(Math.min(1, s.life / 750) * Math.PI);
      const segs = 14;
      for (let i = 0; i < segs; i++) {
        ctx!.globalAlpha = fade * (1 - i / segs) * 0.7;
        const size = 4 - (i / segs) * 3;
        ctx!.drawImage(sprites[0], s.x - s.vx * i * 7 - size * 2, s.y - s.vy * i * 7 - size * 2, size * 4, size * 4);
      }
      if (s.life > 750) {
        shooting = null;
        nextShot = now + rand(18000, 40000);
      }
    }

    // Capped at about 60 fps. The motion is tuned per frame, so on a 120 Hz screen it would also run twice as fast.
    let lastFrame = 0;
    function loop(now: number) {
      raf = requestAnimationFrame(loop);
      if (now - lastFrame < 15) return;
      lastFrame = now;
      frame(now);
    }
    function start() {
      cancelAnimationFrame(raf);
      if (isStill()) frame(0, true);
      else raf = requestAnimationFrame(loop);
    }

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => { build(); start(); }, 150);
    });
    window.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      mouseX = e.clientX; mouseY = e.clientY; pointerIn = true;
    }, { passive: true });
    document.documentElement.addEventListener('pointerleave', () => { pointerIn = false; });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else start();
    });
    window.addEventListener('motionchange', start);
    // Held still, the one frame is redrawn on scroll (at most once a frame) so the parallax still lines up.
    let stillQueued = false;
    window.addEventListener('scroll', () => {
      if (!isStill() || stillQueued) return;
      stillQueued = true;
      requestAnimationFrame(() => { stillQueued = false; frame(0, true); });
    }, { passive: true });

    const contact = document.getElementById('contact');
    if (contact) {
      new IntersectionObserver(([e]) => { boostTarget = e.isIntersecting ? 1 : 0; }, { threshold: 0.3 }).observe(contact);
    }

    build();
    start();
  }
</script>
