---
// "How my work has evolved": scroll down a line in space. On wide screens the stage pins and
// scroll progress slides the nodes past a fixed centre point; the active project expands and
// the skills row grows. Phones, reduced motion and no-JS get a plain vertical timeline.
// Data lives in src/data/journey.ts. The starfield warps while you approach the last node.
// Only the home picks show here; /journey has every project.
import Shot from './Shot.astro';
import { published, homeNodes as nodes, future } from '../data/journey';

// Skills come from every project. One first earned at a project that isn't shown here
// lights up at the next one that is (or at the future, if none is).
const skills: { name: string; at: number }[] = [];
published.forEach((n) => {
  const shownAt = nodes.findIndex((h) => published.indexOf(h) >= published.indexOf(n));
  n.stack.forEach((s) => {
    if (!skills.some((k) => k.name === s)) skills.push({ name: s, at: shownAt === -1 ? nodes.length : shownAt });
  });
});
const M = nodes.length + 1; // projects plus the future
---
<section id="journey" class="journey" style={`--m:${M};--hue:${nodes[0].hue}`} aria-labelledby="journey-title" data-journey>
  <div class="stage">
    <div class="frame top">
      <div class="lead">
        <h2 id="journey-title" class="wipe" data-split>How my work has evolved</h2>
        <p class="ways">
          <a class="skipj" href="#about">Skip the timeline</a>
          <a class="link" href="/journey">All {published.length} projects</a>
        </p>
      </div>
      <p class="era" data-era aria-hidden="true">{nodes[0].date}</p>
    </div>

    <p class="ghost" data-ghost aria-hidden="true">{nodes[0].date.split(' ').pop()}</p>
    <div class="line" aria-hidden="true"><i class="trail"></i><i class="ahead"></i></div>
    <div class="ring" aria-hidden="true"></div>

    <ol class="nodes">
      {nodes.map((n, i) => (
        <li class:list={['node', i % 2 ? 'left' : 'right', { active: i === 0 }]} style={`--i:${i};--hue:${n.hue}`} data-node data-date={n.date} data-hue={n.hue}>
          <p class="tag" aria-hidden="true"><span>{n.date}</span> {n.title}</p>
          <article class="card" data-reveal data-card aria-label={n.title}>
            <div class="shotwrap" data-polish={n.polish}>
              <Shot src={n.image} alt={n.alt} host={n.host} sizes="(max-width: 900px) 92vw, 520px" />
            </div>
            <div class="body">
              <h3>{n.title}</h3>
              <p class="meta">{n.date} · {n.role}</p>
              <p class="stack">{n.stack.join(' · ')}</p>
              <p class="learned">{n.learned}</p>
              {n.href && (
                <p class="links">
                  <a class="link" href={`/journey#${n.id}`}>Read the story</a>
                  <a class="link" href={n.href}>{n.href.startsWith('/') ? 'Case study' : 'Visit'}</a>
                </p>
              )}
            </div>
          </article>
        </li>
      ))}

      <li class="node future left" style={`--i:${nodes.length};--hue:${future.hue}`} data-node data-date={future.date} data-hue={future.hue}>
        <p class="tag" aria-hidden="true"><span>{future.date}</span> {future.title}</p>
        <article class="card future-card" data-reveal data-card aria-label={`Next: ${future.title}`}>
          <div class="star" aria-hidden="true"></div>
          <div class="body">
            <h3>Next: {future.title}</h3>
            <p class="learned">{future.text}</p>
            <p class="links"><a class="link" href="#contact">Get in touch</a><a class="link" href="/journey">All {published.length} projects</a></p>
          </div>
        </article>
      </li>
    </ol>

    <div class="skills">
      <p class="label">Skills picked up along the way</p>
      <ul>
        {skills.map((s) => <li class="chip" data-chip data-at={s.at}>{s.name}</li>)}
      </ul>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-journey]');
  if (root) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const wide = matchMedia('(min-width: 901px)');
    const items = [...root.querySelectorAll<HTMLElement>('[data-node]')];
    const cards = items.map((el) => el.querySelector<HTMLElement>('[data-card]')!);
    const chips = [...root.querySelectorAll<HTMLElement>('[data-chip]')];
    const era = root.querySelector<HTMLElement>('[data-era]')!;
    const ghost = root.querySelector<HTMLElement>('[data-ghost]')!;
    const M = items.length;
    const w = window as unknown as { __warp?: number; __kick?: number };
    const smooth = (x: number) => { const t = Math.min(1, Math.max(0, x)); return t * t * (3 - 2 * t); };

    let pinned = false, ticking = false, last = -1, inView = true;

    const warpFor = (f: number) => {
      const peak = M - 1.4; // just before the last node
      if (f < peak) return smooth((f - (M - 3.2)) / 1.8);
      return Math.max(0, 1 - (f - peak) / 0.4);
    };

    const update = () => {
      ticking = false;
      if (!pinned) return;
      const total = root.offsetHeight - innerHeight;
      const p = Math.min(1, Math.max(0, -root.getBoundingClientRect().top / total));
      const f = p * (M - 1);
      items.forEach((el, i) => {
        const d = i - f;
        el.style.setProperty('--d', d.toFixed(3));
        el.style.setProperty('--ad', Math.min(Math.abs(d), 3).toFixed(3));
      });
      const a = Math.round(f);
      if (a !== last) {
        items.forEach((el, i) => {
          el.classList.toggle('active', i === a);
          el.classList.toggle('past', i < a);
          cards[i].inert = i !== a;
        });
        chips.forEach((c) => {
          const on = a >= Number(c.dataset.at);
          // A chip earned at this node flashes in the project's colour, then settles.
          if (on && !c.classList.contains('on') && Number(c.dataset.at) === a) {
            c.style.setProperty('--flash', items[a].dataset.hue ?? '');
            c.classList.add('fresh');
            setTimeout(() => c.classList.remove('fresh'), 1400);
          }
          c.classList.toggle('on', on);
        });
        const date = items[a].dataset.date ?? '';
        era.textContent = date;
        ghost.textContent = date.split(' ').pop() ?? '';
        for (const el of [era, ghost]) { el.classList.remove('tick'); void el.offsetWidth; el.classList.add('tick'); }
        root.style.setProperty('--hue', items[a].dataset.hue ?? '');
        root.classList.toggle('at-end', a === M - 1);
        if (a === M - 1) w.__kick = performance.now(); // the last star ignites: the field pulses
        last = a;
      }
      w.__warp = warpFor(f);
    };

    const onScroll = () => { if (inView && !ticking) { ticking = true; requestAnimationFrame(update); } };
    // Off screen there is nothing to move: skip the layout reads. One last update as it leaves keeps the end state right.
    new IntersectionObserver(([e]) => {
      const was = inView;
      inView = !!e?.isIntersecting;
      if (was && !inView && !ticking) { ticking = true; requestAnimationFrame(update); }
      if (inView) onScroll();
    }, { rootMargin: '200px 0px' }).observe(root);

    const setMode = () => {
      pinned = wide.matches && !reduce.matches;
      root.classList.toggle('pinned', pinned);
      last = -1;
      if (pinned) update();
      else {
        w.__warp = 0;
        cards.forEach((c) => (c.inert = false));
        items.forEach((el) => el.classList.remove('active', 'past'));
      }
    };
    wide.addEventListener('change', setMode);
    reduce.addEventListener('change', setMode);
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    setMode();
  }
</script>

<style>
  /* ---------- default: plain vertical timeline (phones, reduced motion, no JS) ---------- */
  .journey { padding-block: var(--section); }
  /* The plain list never traps anyone, so there Skip only appears for keyboard users. */
  .ways { margin-top: 1rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  .skipj {
    display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1.25rem;
    border-radius: var(--btn-radius); background: var(--surface); color: var(--ink); text-decoration: none;
    transition: transform 140ms var(--ease-out), background-color 180ms ease;
  }
  .skipj:hover { background: var(--surface-2); }
  .skipj:active { transform: scale(0.97); }
  .journey:not(.pinned) .skipj:not(:focus-visible) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; padding: 0; }
  .top { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; }
  h2 { font-size: var(--step-head); }
  .era, .line, .ring { display: none; }
  .nodes { position: relative; margin: 3.5rem auto 0; width: 100%; max-width: var(--max); padding: 0 var(--margin) 0 calc(var(--margin) + 2.25rem); display: grid; gap: 4.5rem; }
  .nodes::before { content: ''; position: absolute; left: calc(var(--margin) + 6px); top: 0.4rem; bottom: 0; width: 2px; background: rgb(143 166 142 / 0.3); }
  .node { position: relative; }
  .node::before { content: ''; position: absolute; left: -2.25rem; top: 0.45rem; width: 14px; height: 14px; border-radius: 50%; background: var(--hue, var(--accent)); }
  .tag { display: none; }
  .card { display: grid; gap: 1.5rem; max-width: 46rem; }
  .shotwrap :global(figure) { max-width: 100%; }
  .shotwrap[data-polish='0'] :global(img) { filter: grayscale(0.85) contrast(0.85) brightness(0.92); }
  .shotwrap[data-polish='1'] :global(img) { filter: grayscale(0.4) contrast(0.93); }
  .shotwrap[data-polish='2'] :global(img) { filter: saturate(0.92); }
  h3 { font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem); }
  .meta { margin-top: 0.4rem; color: var(--muted); font-size: var(--step-small); }
  .stack { margin-top: 0.9rem; font-size: 0.9375rem; color: var(--hue, var(--accent)); }
  .ghost { display: none; }
  .learned { margin-top: 0.9rem; max-width: 42ch; }
  .links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .body p:last-child { margin-top: 1.1rem; }
  .star { width: 56px; height: 56px; border-radius: 50%; background: var(--hue, var(--accent)); }
  .skills { margin: 4rem auto 0; width: 100%; max-width: var(--max); padding: 0 var(--margin); }
  .label { color: var(--muted); font-size: var(--step-small); margin-bottom: 0.9rem; }
  .skills ul { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { background: var(--surface); padding: 0.4rem 0.85rem; border-radius: 999px; font-size: 0.9375rem; }

  /* ---------- pinned: travel down a line in space (wide screens, motion allowed) ---------- */
  .journey.pinned { height: calc(100svh + (var(--m) - 1) * 55svh); padding-block: 0; }
  .pinned .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; --gap: 34svh; --cw: min(40vw, 520px, 56svh); }
  .pinned .top { position: absolute; top: 5rem; left: 0; right: 0; z-index: 3; margin-inline: auto; width: 100%; max-width: var(--max); padding-inline: var(--margin); }
  .pinned h2 { font-size: var(--step-lead); }
  .pinned .era { display: block; font-size: clamp(2rem, 1.2rem + 2.4vw, 4rem); letter-spacing: -0.04em; color: var(--hue); line-height: 1; transition: color 600ms ease; }
  /* A huge outlined year drifting behind everything: the era you are in. */
  .pinned .ghost {
    display: block; position: absolute; left: 50%; top: 50%; z-index: 0;
    transform: translate(-50%, -50%);
    font-size: clamp(9rem, 4rem + 16vw, 22rem); font-weight: 500; letter-spacing: -0.06em; line-height: 1;
    color: transparent; -webkit-text-stroke: 1.5px var(--hue); opacity: 0.16;
    white-space: nowrap; pointer-events: none; transition: -webkit-text-stroke-color 600ms ease;
  }
  .pinned .ghost.tick { animation: ghost 1100ms var(--ease-out); }
  @keyframes ghost { from { opacity: 0; transform: translate(-50%, calc(-50% + 80px)) scale(0.94); } }
  .pinned .era.tick { animation: tick 600ms var(--ease-out); }
  @keyframes tick { from { opacity: 0; transform: translateY(14px); } }
  /* The line: lit behind you (the trail), dim ahead. At the end the road ahead is unwritten. */
  .pinned .line { display: block; position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; margin-left: -1px; z-index: 1; }
  .pinned .line i { position: absolute; left: 0; width: 100%; }
  .pinned .trail { top: 0; height: 50%; background: var(--hue); opacity: 0.85; transition: background-color 600ms ease; }
  .pinned .ahead { top: 50%; bottom: 0; background: rgb(255 255 255 / 0.14); transform-origin: top; transition: transform 900ms var(--ease-out), opacity 900ms ease; }
  .pinned.at-end .ahead { transform: scaleY(0); opacity: 0; }
  .pinned .ring { display: block; position: absolute; left: 50%; top: 50%; width: 38px; height: 38px; margin: -19px 0 0 -19px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--hue); /* taste-skill-ignore */ animation: ping 4.8s var(--ease-out) infinite; z-index: 1; transition: box-shadow 600ms ease; }
  @keyframes ping { 0%, 60%, 100% { transform: scale(1); opacity: 0.9; } 8% { transform: scale(1.55); opacity: 0.2; } 16% { transform: scale(1); opacity: 0.9; } 24% { transform: scale(1.3); opacity: 0.35; } 32% { transform: scale(1); } }

  .pinned .nodes { position: absolute; inset: 0; margin: 0; padding: 0; max-width: none; display: block; }
  .pinned .nodes::before { display: none; }
  .pinned .node {
    --d: 0; --ad: 0;
    position: absolute; left: 50%; top: 50%; width: 0; height: 0; z-index: 2;
    perspective: 1400px;
    transform: translateY(calc(var(--d) * var(--gap)));
    opacity: calc(1 - var(--ad) * 0.34);
  }
  .pinned .node::before { left: -7px; top: -7px; background: var(--surface-2); transition: background-color 400ms ease, transform 500ms var(--ease-out); }
  .pinned .node.past::before, .pinned .node.active::before { background: var(--hue); }
  .pinned .node.active::before { transform: scale(1.6); }
  .pinned .tag { display: block; position: absolute; top: -0.7rem; width: max-content; max-width: 28vw; font-size: 0.9375rem; color: var(--muted); transition: opacity 300ms ease; }
  .pinned .tag span { color: var(--hue); margin-right: 0.4rem; }
  .pinned .right .tag { left: 28px; }
  .pinned .left .tag { right: 28px; text-align: right; }
  .pinned .active .tag { opacity: 0; }

  .pinned .card {
    position: absolute; top: 0; width: var(--cw); max-width: none;
    --hold: calc(var(--d) * var(--gap) * -0.75); /* cancel most of the node's travel: the card stays near centre */
    transform: translateY(calc(-50% + 40px + var(--hold))) rotateY(var(--swing)) scale(0.94); opacity: 0; visibility: hidden;
    transition: opacity 600ms ease, transform 900ms var(--ease-out), visibility 0s linear 600ms;
  }
  .pinned .right .card { --swing: -14deg; transform-origin: left center; }
  .pinned .left .card { --swing: 14deg; transform-origin: right center; }
  /* The active screenshot gets a ring in the project's own colour. */
  .pinned .active .shotwrap { border-radius: 10px; box-shadow: 0 0 0 1.5px var(--hue), 0 30px 80px -30px var(--hue); /* taste-skill-ignore */ }
  .pinned .right .card { left: 60px; }
  .pinned .left .card { right: 60px; }
  .pinned .active .card { transform: translateY(calc(-50% + var(--hold))); opacity: 1; visibility: visible; transition-delay: 120ms, 120ms, 0s; }
  .pinned .card > :global(*) { opacity: 1 !important; transform: none !important; } /* reveal effect is for the list layout */
  .pinned .card { gap: 1rem; }
  .pinned h3 { font-size: clamp(1.375rem, 1rem + 1vw, 2rem); }
  .pinned .learned, .pinned .stack { margin-top: 0.5rem; font-size: 1rem; }
  .pinned .body p:last-child { margin-top: 0.75rem; }
  .pinned .meta { margin-top: 0.25rem; }
  .pinned .future-card { grid-template-columns: auto 1fr; align-items: center; gap: 1.5rem; }

  /* The last star: dark until you arrive, then it ignites and beats with the field. */
  .pinned .future .star { background: transparent; box-shadow: inset 0 0 0 1.5px var(--muted); /* taste-skill-ignore */ transition: background-color 500ms ease; }
  .pinned .future.active .star { background: var(--accent); box-shadow: 0 0 40px 10px rgb(143 166 142 / 0.55); /* taste-skill-ignore */ animation: beat 4.8s var(--ease-out) infinite; }
  @keyframes beat { 0%, 60%, 100% { transform: scale(1); } 8% { transform: scale(1.18); } 16% { transform: scale(1); } 24% { transform: scale(1.1); } }

  .pinned .skills { position: absolute; bottom: 1.25rem; left: 0; right: 0; margin: 0 auto; z-index: 3; padding-right: calc(var(--margin) + 64px); } /* clear of the back-to-top button */
  .pinned .skills ul { gap: 0.4rem; }
  .pinned .chip { padding: 0.3rem 0.7rem; font-size: 0.9375rem; opacity: 0; transform: translateY(10px) scale(0.92); transition: opacity 400ms ease, transform 500ms var(--ease-out); }
  .pinned .chip.on { opacity: 1; transform: none; }
  .pinned .chip.fresh { animation: earn 1400ms var(--ease-out); }
  @keyframes earn { 0% { background: var(--flash); color: #111; transform: scale(1.12); } 60% { background: var(--flash); color: #111; } 100% { transform: none; } }

  @media (prefers-reduced-motion: reduce) {
    .era.tick, .ghost.tick, .ring, .star, .chip.fresh { animation: none !important; }
  }
</style>
