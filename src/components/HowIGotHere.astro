---
// Closes Featured work with the two ways on: the Journey (the story) and All work (everything else).
---
<section id="journey" class="frame band" aria-labelledby="journey-title">
  <div class="words" data-reveal>
    <h2 id="journey-title" class="wipe" data-split>How I got here</h2>
    <p class="lead">From my first API key in 2025 to an AI security game in 2026: what each project taught me, oldest first.</p>
  </div>
  <p class="go" data-reveal>
    <a class="btn btn-quiet" href="/journey">My journey</a>
    <a class="link" href="/projects">See all work</a>
  </p>
</section>

<style>
  .band {
    padding-block: calc(var(--section) * 0.4) 0;
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 2rem 4rem;
  }
  .go { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  h2 { font-size: var(--step-head); }
  .lead { margin-top: 1.5rem; max-width: 38ch; font-size: var(--step-lead); line-height: 1.3; }
</style>
