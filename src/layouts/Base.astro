---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Starfield from '../components/Starfield.astro';
import Preloader from '../components/Preloader.astro';
import BackToTop from '../components/BackToTop.astro';
import { site } from '../data/site';
import { certifications } from '../data/experience';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
  intro?: boolean;  // first-visit preloader (home only)
  footer?: boolean; // the home page ends with the contact pyramid instead
  noindex?: boolean; // keep the page out of search (404, empty pages)
}
const { title, description = site.description, jsonLd, intro = false, footer = true, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}, ${site.role.toLowerCase()}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: Astro.site?.toString(),
  sameAs: [site.github, site.linkedin],
  hasCredential: certifications.map((c) => ({
    '@type': 'EducationalOccupationalCredential',
    name: c.title,
    credentialCategory: 'certificate',
    recognizedBy: { '@type': 'Organization', name: 'Google' },
    ...(c.verify && { url: c.verify }),
  })),
};
---
<!doctype html>
<html lang="en-GB" data-intro={intro ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1c1c1c" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/clash-grotesk-400.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={new URL('/og.jpg', Astro.site)} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var seen = false, still = false;
        try { seen = sessionStorage.getItem('intro-seen') === '1'; still = localStorage.getItem('still') === '1'; } catch (e) {}
        if (still) d.classList.add('still');
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (d.hasAttribute('data-intro') && !seen && !reduce && !still) d.classList.add('intro');
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? person)} />
  </head>
  <body>
    <Starfield />
    {intro && <Preloader />}
    <a href="#main" class="skip">Skip to content</a>
    <Header />
    <main id="main" class:list={{ pad: !intro }}>
      <slot />
    </main>
    {footer && <Footer />}
    <BackToTop />
    <script>
      import { initReveals } from '../scripts/motion';
      initReveals();
      // Pages without the preloader are ready straight away.
      if (!document.documentElement.hasAttribute('data-intro')) document.documentElement.classList.add('ready');
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute; left: var(--margin); top: -4rem; z-index: 110;
    background: var(--accent); color: var(--accent-ink);
    padding: 0.75rem 1rem; border-radius: var(--btn-radius); text-decoration: none;
  }
  .skip:focus-visible { top: 1rem; }
  .pad { padding-top: 5.5rem; }
</style>
