---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import { nodes, future } from '../data/journey';
---
<Base title="Journey" description="Five projects and what each one taught Musa Burke, from a first API key to a live client site.">
  <section class="frame head" data-reveal>
    <h1>What each site taught me</h1>
    <p class="lead">Five projects, oldest first, and the main thing I took from each one.</p>
  </section>

  {nodes.map((n) => (
    <section class="frame story" id={n.id} style={`--hue:${n.hue}`} aria-labelledby={`h-${n.id}`}>
      <div class="words" data-reveal>
        <h2 id={`h-${n.id}`}>{n.title}</h2>
        <p class="meta">{n.date} · {n.role}</p>
        <p class="takeaway">{n.learned}</p>
        {n.story.map((para) => <p class="para">{para}</p>)}
        <p class="stack">{n.stack.join(' · ')}</p>
        {n.href && <p class="go"><a class="link" href={n.href}>{n.href.startsWith('/') ? 'Read the case study' : 'Visit'}</a></p>}
      </div>
      <div class="shots" data-reveal>
        <Shot src={n.image} alt={n.alt} host={n.host} sizes="(max-width: 900px) 92vw, 50vw" />
        {n.more && <Shot src={n.more.image} alt={n.more.alt} host={n.host} sizes="(max-width: 900px) 92vw, 50vw" />}
      </div>
    </section>
  ))}

  <section class="frame next" style={`--hue:${future.hue}`} aria-labelledby="h-next" data-reveal>
    <h2 id="h-next">Next: {future.title}</h2>
    <p class="para">{future.text}</p>
    <p class="go"><a class="btn" href="/#contact">Get in touch</a></p>
  </section>
</Base>

<style>
  .head { padding-top: 4rem; }
  h1 { font-size: var(--step-head); }
  .lead { margin-top: 1.5rem; font-size: var(--step-lead); line-height: 1.3; max-width: 40ch; }
  .story {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 5rem);
    align-items: start; margin-top: var(--section); scroll-margin-top: 6rem;
  }
  .story:nth-of-type(odd) .words { order: 2; }
  h2 { font-size: var(--step-head); color: var(--hue); line-height: 1.05; }
  .meta { margin-top: 0.75rem; color: var(--muted); font-size: var(--step-small); }
  .takeaway { margin-top: 1.5rem; font-size: var(--step-lead); line-height: 1.3; }
  .para { margin-top: 1.25rem; max-width: 60ch; }
  .stack { margin-top: 1.5rem; color: var(--hue); font-size: var(--step-small); }
  .go { margin-top: 1.5rem; }
  .shots { display: grid; gap: 1.5rem; }
  .next { margin-top: var(--section); padding-bottom: var(--section); }
  @media (max-width: 900px) {
    .story { grid-template-columns: minmax(0, 1fr); }
    .story:nth-of-type(odd) .words { order: 0; }
  }
</style>
