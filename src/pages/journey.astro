---
import Base from '../layouts/Base.astro';
import Journey from '../components/Journey.astro';

---
<Base title="Journey" description="How Musa Burke's work has evolved, oldest first: what each project was and what it taught him.">
  <Journey />

  <section class="frame next" id="after-journey" aria-labelledby="h-end" data-reveal>
    <h2 id="h-end">See the finished work</h2>
    <p class="go2">
      <a class="btn" href="/projects">See all work</a>
      <a class="link" href="/#contact">Get in touch</a>
    </p>
  </section>
</Base>

<style>
  .next { padding-block: var(--section); }
  .next h2 { font-size: var(--step-head); }
  .go2 { margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
</style>
