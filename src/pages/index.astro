---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import HowIGotHere from '../components/HowIGotHere.astro';
import About from '../components/About.astro';
import Toolkit from '../components/Toolkit.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';
const webSite = [{ '@type': 'WebSite', name: `${site.name}, portfolio`, url: new URL('/', Astro.site).toString(), inLanguage: 'en-GB', author: { '@id': new URL('/#musa', Astro.site).toString() } }];
---
<Base intro footer={false} jsonLd={webSite}>
  <Hero />
  <Work />
  <HowIGotHere />
  <About />
  <Toolkit />
  <Contact />
</Base>
