---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="frame nf">
    <h1>Nothing in this room</h1>
    <p class="muted">The page you wanted isn't here. It may have moved.</p>
    <p><a class="btn" href="/">Back to the start</a></p>
  </section>
</Base>

<style>
  .nf { padding-top: 20vh; display: grid; gap: 1.5rem; justify-items: start; }
  h1 { font-size: var(--step-head); }
</style>
