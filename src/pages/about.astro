---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { experience, education, type Entry } from '../data/experience';
import { toolkit } from '../data/toolkit';
const groups: { title: string; items: Entry[] }[] = [
  { title: 'Experience', items: experience },
  { title: 'Education', items: education },
];
---
<Base title="About" description={site.description}>
  <section class="frame head" data-reveal>
    <h1>About</h1>
    <p class="lead">
      I'm {site.name}, a student front-end developer. I build websites that load fast, read clearly and work on a phone,
      and I'm studying toward cyber security.
    </p>
    <p class="links">
      <a class="btn" href={`mailto:${site.email}`}>Email me</a>
      <a class="link" href={site.github} rel="me">GitHub</a>
      <a class="link" href={site.linkedin} rel="me">LinkedIn</a>
      {site.cv && <a class="link" href={site.cv}>Download CV</a>}
    </p>
  </section>

  {groups.map((g) => (
    <section class="frame block" aria-labelledby={`h-${g.title}`}>
      <h2 id={`h-${g.title}`}>{g.title}</h2>
      <ol class="timeline">
        {g.items.map((e) => (
          <li data-reveal>
            <p class="when muted">{e.when}</p>
            <div>
              <h3>{e.href ? <a class="link" href={e.href}>{e.title}</a> : e.title}</h3>
              <p class="where muted">{e.where}</p>
              <p class="detail">{e.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}

  <section class="frame block" aria-labelledby="h-skills">
    <h2 id="h-skills">Skills</h2>
    <ul class="skills">
      {toolkit.map((t) => (
        <li data-reveal><h3>{t.name}</h3><p class="detail">{t.detail}</p></li>
      ))}
      <li data-reveal><h3>Also</h3><p class="detail">Java (object-oriented coursework), Python, Git, Swift basics.</p></li>
    </ul>
  </section>
</Base>

<style>
  .head { padding-top: 4rem; max-width: 60rem; margin-inline: 0; }
  h1 { font-size: var(--step-head); }
  .lead { margin-top: 1.5rem; font-size: var(--step-lead); line-height: 1.3; max-width: 40ch; }
  .links { margin-top: 2rem; display: flex; align-items: center; flex-wrap: wrap; gap: 1.5rem; }
  .block { display: grid; grid-template-columns: 1fr 3fr; gap: clamp(1.5rem, 4vw, 4rem); margin-top: var(--section); }
  h2 { font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem); }
  .timeline { display: grid; gap: 3rem; }
  .timeline li { display: grid; grid-template-columns: 8rem 1fr; gap: 1.5rem; }
  h3 { font-size: var(--step-lead); letter-spacing: -0.02em; }
  .where { margin-top: 0.25rem; }
  .detail { margin-top: 0.75rem; max-width: 60ch; }
  .when { font-variant-numeric: tabular-nums; padding-top: 0.35rem; }
  .skills { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem 3rem; }
  .skills li:nth-child(odd) { padding-right: 1rem; }
  @media (max-width: 760px) {
    .block { grid-template-columns: 1fr; }
    .timeline li { grid-template-columns: 1fr; gap: 0.25rem; }
    .skills { grid-template-columns: 1fr; }
  }
</style>
