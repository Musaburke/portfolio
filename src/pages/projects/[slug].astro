---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import { getWork, showDate } from '../../lib/work';

export async function getStaticPaths() {
  const { caseStudies } = await getWork();
  // Each case study ends by pointing at the next one (the last loops to the first).
  return caseStudies.map((p, i) => ({ params: { slug: p.id }, props: { p, next: caseStudies[(i + 1) % caseStudies.length]! } }));
}
const { p, next } = Astro.props;
const { Content } = await render(p.caseStudy!);
const d = p.caseStudy!.data;
---
<Base title={p.title} description={p.summary}>
  <article class="frame case">
    <header class="top" data-reveal>
      <p class="back"><a class="link muted" href="/projects">All work</a></p>
      <h1>{p.title}</h1>
      <p class="lead">{p.summary}</p>
      <p class="proof-links">
        {p.live && <a class="btn btn-quiet" href={p.live}>Visit the live site</a>}
        {p.repo ? <a class="btn btn-quiet" href={p.repo}>Code on GitHub</a> : p.repoNote && <span class="muted">Code: {p.repoNote.toLowerCase()}</span>}
      </p>
    </header>

    <div class="cover" data-reveal>
      <Shot src={d.cover} alt={d.coverAlt} host={p.host} sizes="(max-width: 1440px) 100vw, 1376px" eager />
    </div>

    <div class="body">
      <dl class="meta">
        <div><dt>Date</dt><dd>{showDate(p.date)}</dd></div>
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        <div><dt>Stack</dt><dd>{p.stack.join(', ')}</dd></div>
        {p.live && <div><dt>Live</dt><dd><a class="link" href={p.live}>{new URL(p.live).hostname}</a></dd></div>}
        {p.repo ? <div><dt>Code</dt><dd><a class="link" href={p.repo}>GitHub</a></dd></div> : p.repoNote && <div><dt>Code</dt><dd>{p.repoNote}</dd></div>}
      </dl>
      <div class="prose">
        <Content />
        {p.journey && (
          <section aria-labelledby="changed-title">
            <h2 id="changed-title">How it changed me</h2>
            {p.journey.story.map((para) => <p>{para}</p>)}
          </section>
        )}
      </div>
    </div>

    {d.gallery.length > 0 && (
      <section class="gallery" aria-labelledby="gallery-title">
        <h2 id="gallery-title">More screens</h2>
        <div class="grid">
          {d.gallery.map((g) => (
            <figure data-reveal>
              <Shot src={g.src} alt={g.alt} host={p.host} sizes="(max-width: 900px) 100vw, 50vw" />
              <figcaption class="muted">{g.alt}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}
    {(p.live || p.repo) && (
      <section class="proof" aria-labelledby="proof-title" data-reveal>
        <h2 id="proof-title">See it for yourself</h2>
        <p class="proof-links">
          {p.live && <a class="btn btn-quiet" href={p.live}>Visit the live site</a>}
          {p.repo ? <a class="btn btn-quiet" href={p.repo}>Code on GitHub</a> : p.repoNote && <span class="muted">Code: {p.repoNote.toLowerCase()}</span>}
        </p>
      </section>
    )}
    {next.id !== p.id && (
      <section class="next" aria-labelledby="next-title">
        <div class="next-text" data-reveal>
          <h2 id="next-title">Next: {next.title}</h2>
          <p class="lead">{next.summary}</p>
          <p class="next-go">
            <a class="btn" href={`/projects/${next.id}`}>Read the case study</a>
            <a class="link" href="/projects">All work</a>
          </p>
        </div>
        <a class="next-pic" href={`/projects/${next.id}`} tabindex="-1" aria-hidden="true" data-reveal>
          <Shot src={next.caseStudy!.data.cover} alt="" host={next.host} sizes="(max-width: 900px) 100vw, 50vw" />
        </a>
      </section>
    )}
  </article>
</Base>

<style>
  .top { padding-top: 4rem; max-width: 52rem; }
  .proof-links { margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; }
  .proof { margin-top: var(--section); }
  .proof h2 { font-size: var(--step-head); }
  .back { font-size: var(--step-small); margin-bottom: 2rem; }
  h1 { font-size: clamp(2.5rem, 1.1rem + 4.6vw, 5.25rem); letter-spacing: -0.04em; line-height: 1; }
  .lead { margin-top: 1.5rem; font-size: var(--step-lead); line-height: 1.3; max-width: 40ch; }
  .cover { margin-top: 4rem; }
  .body { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2vw, 2rem); margin-top: 6rem; }
  .meta { grid-column: 1 / 4; display: grid; gap: 1.25rem; align-content: start; font-size: 1rem; position: sticky; top: 2rem; }
  .prose { grid-column: 5 / 13; }
  dt { color: var(--muted); font-size: var(--step-small); }
  .gallery { margin-top: var(--section); }
  .gallery h2 { font-size: var(--step-head); margin-bottom: 3rem; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 3vw, 2.75rem); align-items: start; }
  figure { margin: 0; display: grid; gap: 1rem; }
  figcaption { font-size: var(--step-small); max-width: 50ch; }
  .next { margin-top: var(--section); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2vw, 2rem); align-items: center; }
  .next-text { grid-column: 1 / 6; }
  .next h2 { font-size: var(--step-head); line-height: 1.05; }
  .next-go { margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  .next-pic { grid-column: 7 / 13; display: block; }
  @media (max-width: 900px) {
    .next { display: block; }
    .next-pic { display: block; margin-top: 2.5rem; }
    .body { display: block; }
    .meta { position: static; margin-bottom: 3rem; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
