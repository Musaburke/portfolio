---
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import { getWork, showDate } from '../../lib/work';
import { site } from '../../data/site';

// Every project, newest first, one equal card each. A card links to one place: the case study if there is one.
const { allWork } = await getWork();
const label = (p: (typeof allWork)[number]) =>
  p.caseStudy ? 'Read the case study' : p.href?.includes('github.com') ? 'Code on GitHub' : 'Visit site';
---
<Base title="All work" description="Everything Musa Burke has built, newest first, with a full case study for the main projects.">
  <section class="frame head" data-reveal>
    <h1>All work</h1>
    <p class="lead">Everything I've built, newest first. The ones marked case study have the full write-up.</p>
  </section>

  <section class="frame" aria-labelledby="list-title">
    <h2 id="list-title" class="visually-hidden">Projects</h2>
    <ul class="cards">
      {allWork.map((p, i) => (
        <li class="card" data-reveal>
          {p.href ? (
            <a class="pic" href={p.href} tabindex="-1" aria-hidden="true">
              <Shot src={p.image} alt="" host={p.host} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw" eager={i < 3} />
            </a>
          ) : (
            <Shot src={p.image} alt={p.alt} host={p.host} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw" />
          )}
          <h3>{p.href ? <a href={p.href}>{p.title}</a> : p.title}</h3>
          <p class="meta">{showDate(p.date)}{p.caseStudy && <span class="badge">Case study</span>}</p>
          <p class="summary">{p.summary}</p>
          {p.href && <p class="go"><a class="link" href={p.href}>{label(p)}<span class="visually-hidden">: {p.title}</span></a></p>}
        </li>
      ))}
    </ul>
  </section>

  <section class="frame end" aria-labelledby="end-title">
    <h2 id="end-title" data-reveal>See how it fits together</h2>
    <p class="go2" data-reveal>
      <a class="btn btn-quiet" href="/journey">My journey</a>
      <a class="link" href={`mailto:${site.email}`}>Email me</a>
    </p>
  </section>
</Base>

<style>
  .head { padding-top: 4rem; }
  h1 { font-size: var(--step-head); }
  .lead { margin-top: 1.5rem; max-width: 40ch; font-size: var(--step-lead); line-height: 1.3; }
  .cards { margin-top: 4rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(3rem, 5vw, 4.5rem) clamp(1.5rem, 3vw, 2.5rem); align-items: start; }
  .card { display: grid; gap: 0.75rem; }
  .pic { display: block; margin-bottom: 0.5rem; transition: transform 220ms var(--ease-out); }
  .card:hover .pic { transform: translateY(-4px); }
  h3 { font-size: var(--step-lead); letter-spacing: -0.02em; line-height: 1.15; }
  h3 a { text-decoration: none; transition: color 180ms ease; }
  h3 a:hover { color: var(--accent); }
  h3 a:active { opacity: 0.8; }
  .meta { display: flex; align-items: center; gap: 0.75rem; color: var(--muted); font-size: var(--step-small); }
  .badge { background: var(--surface); color: var(--ink); padding: 0.2rem 0.7rem; border-radius: 999px; font-size: 0.9375rem; }
  .summary { max-width: 46ch; }
  .end { margin-top: var(--section); padding-bottom: var(--section); }
  .end h2 { font-size: var(--step-head); }
  .go2 { margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  @media (max-width: 1100px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) { .cards { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .pic, .card:hover .pic { transition: none; transform: none; } }
</style>
