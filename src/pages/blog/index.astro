---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Writing" noindex={posts.length === 0} description="Notes on front-end development and web security by Musa Burke.">
  <section class="frame head" data-reveal>
    <h1>Writing</h1>
    <p class="lead">Notes on building for the web, and what I'm learning about security.</p>
  </section>
  <section class="frame" aria-label="Posts">
    {posts.length === 0 ? (
      <p class="empty">
        The first posts are being written. Meanwhile, the work is on <a class="link" href={site.github} rel="me">GitHub</a>.
      </p>
    ) : (
      <ul class="posts">
        {posts.map((p) => (
          <li data-reveal>
            <a href={`/blog/${p.id}`}>
              <h2>{p.data.title}</h2>
              <p class="muted">{p.data.description}</p>
              <time class="muted" datetime={p.data.pubDate.toISOString()}>{fmt.format(p.data.pubDate)}</time>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .head { padding-top: 4rem; }
  h1 { font-size: var(--step-head); }
  .lead { margin-top: 1.5rem; font-size: var(--step-lead); line-height: 1.3; max-width: 40ch; }
  .empty { margin-top: 4rem; font-size: var(--step-lead); max-width: 40ch; color: var(--muted); }
  .posts { margin-top: 5rem; display: grid; gap: 1rem; max-width: 52rem; }
  .posts a { display: grid; gap: 0.4rem; padding: 1.5rem; margin-inline: -1.5rem; text-decoration: none; transition: background-color 180ms ease; }
  .posts a:hover { background: var(--surface); }
  h2 { font-size: var(--step-lead); letter-spacing: -0.02em; }
  time { font-size: var(--step-small); }
</style>
